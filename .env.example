# Optional local Docker overrides.
# The recommended startup command is: make dev-up
# It generates a random local UI password in memory and does not write plaintext
# credentials to this file.

NAPMS_WEB_PORT=8080
NAPMS_LOCAL_AUTH_LOGIN=local-admin
NAPMS_LOCAL_AUTH_ACTOR_ID=local-admin

# For raw "docker compose up", provide a supported scrypt-v1 hash here or export
# NAPMS_LOCAL_AUTH_PASSWORD_HASH in the shell. Do not commit plaintext passwords.
NAPMS_LOCAL_AUTH_PASSWORD_HASH=
