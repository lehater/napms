@startuml NAPMS_Bounded_Contexts

!theme plain
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam componentStyle rectangle
skinparam linetype ortho
skinparam ArrowColor #555555
skinparam packageBorderColor #555555
skinparam packageBackgroundColor #FFFFFF
skinparam componentBorderColor #777777
skinparam componentBackgroundColor #F7F7F7
skinparam noteBorderColor #AAAAAA
skinparam noteBackgroundColor #FFFDF3

hide stereotype

title NAPMS — Target Bounded Context Map (MVP DDD baseline)

package "Business Connectivity\n<<Bounded Context>>" as BC {
  rectangle "Business Process\nConnectivity Need\nBusiness attribution" as BC_CORE
}

package "Access Policy\n<<Bounded Context>>" as AP {
  rectangle "PolicyRule\nRuleChange\nPending -> Accepted | Rejected\nCurrent effective revision / withdrawal" as AP_CORE
}

package "Authority Management\n<<Bounded Context>>" as AM {
  rectangle "Actor + Action + Scope + Time\nEffective Authority" as AM_CORE
}

package "Application Communication Catalogue\n<<Bounded Context>>" as ACC {
  rectangle "Application\nComponent\nInteraction\nInteractionContractRevision" as ACC_CORE
}

package "Application Deployment\n<<Bounded Context>>" as AD {
  rectangle "ComponentDeployment\nComponentRef\nResourceRef" as AD_CORE
}

package "Resource Catalogue\n<<Bounded Context>>" as RC {
  rectangle "Resource\nHostAddress | Prefix\nResourceScopeAffiliation\nResourceResponsibility" as RC_CORE
}

package "Network Enforcement Placement\n<<Bounded Context>>" as NEP {
  rectangle "Firewall candidate relevance\nAccess-list / policy locator" as NEP_CORE
}

package "Technical Access Evidence\n<<Bounded Context>>" as TAE {
  rectangle "Immutable source-qualified\ntechnical evidence" as TAE_CORE
}

package "Access Policy Realization\n<<Bounded Context>>" as APR {
  rectangle "Required vs configured\ncommon / missing / excess\nVerifiedChangeIntent" as APR_CORE
}

package "Network Environment Operations\n<<Bounded Context>>" as NEO {
  rectangle "Controlled mutation\nAuthority / preconditions\nOutcome / provenance" as NEO_CORE
}

component "Evidence Access\nRecognition\n<<Derived Composition>>" as EAR
component "Required Policy\nMaterialization\n<<Derived Composition>>" as RPM
component "Provider Policy\nInterpreter\n<<Integration Capability>>" as PPI
component "Provider Policy\nRenderer\n<<Integration Capability>>" as PPR
cloud "Provider / Network\nEnvironment" as PROVIDER

' Business meaning and policy lifecycle
ACC --> BC : InteractionRef
BC --> AP : ConnectivityNeed /\nBusinessProcess basis
ACC --> AP : InteractionContractRevisionRef
AD --> AP : source / destination\nComponentDeploymentRef
AM ..> AP : protected action admission\nwhen configured

' Catalogue / deployment / resource ownership
ACC --> AD : ComponentRef
RC --> AD : opaque ResourceRef
AM ..> ACC : curation authority
AM ..> RC : curation authority
AM ..> AD : protected actions

' Evidence recognition
TAE --> EAR : technical evidence
RC --> EAR : address / Resource truth
AD --> EAR : ComponentDeployment truth
ACC --> EAR : Interaction / revision truth
EAR --> AP : RecognizedAccessCandidate

' Semantic-to-technical materialization
AP --> RPM : current effective PolicyRules
ACC --> RPM : immutable traffic contract
AD --> RPM : ComponentDeployment -> ResourceRef
RC --> RPM : Resource -> AddressSpace
NEP --> RPM : FirewallCandidate /\naccessListNames
RPM --> APR : TargetRequiredPolicy[]\nor unresolved

' Configured truth, remediation and execution
PROVIDER --> PPI : provider-native policy
PPI --> APR : ConfiguredEffectivePolicySnapshot
APR --> PPR : VerifiedChangeIntent\nENSURE-PERMIT
PPR --> NEO : TargetPolicyArtifact
AM --> NEO : mutation authority
NEO --> PROVIDER : controlled mutation
PROVIDER --> TAE : source-qualified capture

note bottom of AP
No separate Access Governance BC.
MVP models one formal RuleChange outcome only.
Customer-specific bilateral/quorum workflow is external.
end note

note bottom of EAR
Not a Bounded Context.
Recognition derives a candidate only;
it does not authorize access.
end note

note bottom of RPM
Not a Bounded Context.
Derived composition over published owner truth.
end note

note bottom of PPI
Not a Bounded Context.
Interprets provider-specific semantics
into source-neutral configured policy.
end note

note bottom of PPR
Not a Bounded Context.
Renders verified semantic intent
without changing its meaning.
end note

legend right
  |= Symbol |= Meaning |
  | package | Target Bounded Context |
  | component | Derived / integration capability |
  | cloud | External provider/network environment |
  | solid arrow | Primary semantic contract / fact flow |
  | dotted arrow | Protected-action authority dependency |
endlegend

@enduml
